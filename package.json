{
	"name": "companion-module-tfc",
	"version": "2.2.0",
	"description": "Companion module for TFC",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build",
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "eslint src"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oxe-nep/companion-module-tfc.git"
	},
	"engines": {
		"node": "^22.20 || ^26.5"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.2",
		"eslint": "^9.39.3",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.11",
		"prettier": "^3.8.1",
		"rimraf": "^6.0.1",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.56.1"
	},
	"prettier": {
		"arrowParens": "always",
		"bracketSpacing": true,
		"printWidth": 120,
		"semi": true,
		"singleQuote": true,
		"useTabs": true,
		"endOfLine": "lf"
	},
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	}
}
